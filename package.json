{
  "name": "anne",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "yarn build:crepe && yarn eleventy --config=eleventy.js --input=wwwroot",
    "build:crepe": "rollup -c rollup.config.mjs",
    "watch": "yarn eleventy --config=eleventy.js --input=wwwroot --watch",
    "watch:script": "tsc --watch -p tsconfig.json",
    "serve": "yarn dlx serve _site",
    "fix-recipes": "node ./tools/fix-recipes.mjs"
  },
  "dependencies": {
    "@milkdown/crepe": "^7.22.2",
    "body-parser": "^2.3.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1"
  },
  "packageManager": "yarn@4.18.1",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@akala/core": "^44.2.8",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@types/cookie-parser": "^1.4.10",
    "@types/node": "^26.6.3",
    "marked": "^18.0.14",
    "postcss": "^8.5.28",
    "postcss-import": "^17.0.0",
    "rollup": "^4.63.5",
    "rollup-plugin-postcss": "^4.0.2",
    "typescript": "^7.0.2"
  }
}
