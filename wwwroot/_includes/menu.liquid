<ul>
  <li>
    <a href="/">Accueil</a>
  </li>
  {%- for item in collections.menu %}
    <li{% if item.page.url contains '/admin/' %} class="admin-menu-link"{% endif %}>
      <a href="{{item.page.url}}">{{ item.data.title }}</a>
    </li>
  {% endfor -%}
  <hr/>
  <li>
    <a href="mailto:anne@anneetsesdelices.fr">Contact</a>
  </li>
</ul>
<script>
  if (!localStorage.getItem('GITHUB_TOKEN'))
    document.querySelectorAll('.admin-menu-link').forEach(item => item.remove());
</script>